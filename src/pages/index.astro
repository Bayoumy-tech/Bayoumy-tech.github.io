  aka: "Bayoumy",
  headline: "Husband, Father & Administrator!",
  role: "Security Consultant (OnPrem & Azure)",
  bio: "Experienced System/Network Administrator with 20+ years of technical experience. Focused on Windows servers & Active Directory.",
  email: "ABayoumy@outlook.com",
  site: "https://www.abayoumy.tech",
