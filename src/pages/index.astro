const experience = [
  { role: "Senior Security Consultant", company: "Global Brands", period: "05/2024 – Present", points: ["OnPrem Active Directory Security Assessment & Hardening.", "Implement Microsoft Defender for Identity.", "Implement Microsoft Defender for Office 365."] },
];

const skills = [
  "Active Directory Expert","Windows Server","Windows Security Hardening","PowerShell Scripting",
  "Microsoft Defender for Identity & O365","Office 365 & Azure","VMware vSphere",
  "Networking (Cisco & FortiGate)","Linux Servers & Containers","Team Management & Leadership",
  "LAPS / AD Security Assessments","Zabbix Monitoring"
];

const certifications = [
  "SC-200 Microsoft Certified: Security Operations Analyst Associate",
  "SC-300 Microsoft Certified: Identity and Access Administrator",
  "MCSA 2003","MSITPro 2012","Microsoft Exchange 2007","VB.Net 2003 (Windows & Web)"
];
---

<html lang="en" class="h-full">
<head>
  <meta charset="utf-8" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={`${profile.role} and System/Network Administrator with 20+ years of technical experience focused on Windows servers & Active Directory.`} />
  <meta name="keywords" content="Ahmed Bayoumy, Bayoumy, Security Consultant, Active Directory, Azure, Windows Server" />
  <title>Ahmed Bayoumy | Security Consultant</title>
</head>
<body class="h-full bg-slate-950 text-white font-sans">

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(56,189,248,0.25),transparent_60%)]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl flex flex-col items-center px-6 py-24 text-center">
      <div class="relative mb-6">
        <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-cyan-500 to-blue-600 blur-md"></div>
        <img
          src={profile.avatar}
          alt={profile.name}
          width="128"
          height="128"
          class="relative h-32 w-32 rounded-full border-2 border-white/20 object-cover"
        />
      </div>
      <p class="mb-2 text-sm font-medium uppercase tracking-widest text-cyan-400">{profile.headline}</p>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{profile.name}</h1>
      <p class="mt-2 text-lg text-slate-300">aka <span class="font-semibold text-white">{profile.aka}</span></p>
      <p class="mt-4 text-xl font-medium text-cyan-300">{profile.role}</p>
      <p class="mt-3 max-w-2xl text-slate-300">{profile.bio}</p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={profile.resume} target="_blank" class="rounded-md bg-gradient-to-r from-cyan-500 to-blue-600 px-6 py-2.5 text-sm font-semibold shadow-lg shadow-cyan-500/25 transition hover:opacity-90">View Resume</a>
        <a href={profile.site} target="_blank" class="rounded-md border border-white/20 bg-white/5 px-6 py-2.5 text-sm font-semibold transition hover:bg-white/10">Visit Blog</a>
      </div>

      <div class="mt-8 flex items-center gap-3">
        {socials.map(s => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}
             class="flex h-10 w-10 items-center justify-center rounded-md border border-white/20 bg-white/5 text-slate-300 transition hover:border-cyan-400 hover:text-cyan-400">
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d={s.icon}/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- About / Experience / Skills -->
  <section class="bg-white py-20 text-slate-900 dark:bg-slate-950 dark:text-white">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-2xl font-bold">About Me</h2>
      <p class="mt-4 text-slate-600 dark:text-slate-300">
        Hello there, my name is Ahmed Mohamed Bayoumy, better known as Bayoumy. I am a Security Consultant focused on on-premises Active Directory & Azure, and an experienced System/Network Administrator with over 20 years of technical experience. My work spans servers, networks, analytical thinking and creative problem solving — with a specialty in Windows servers & Active Directory security.
      </p>

      <div class="mt-12 grid gap-8 sm:grid-cols-2">

        <!-- Skills & Certifications -->
        <div class="space-y-10">
          <div>
            <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Skills</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {skills.map(skill => (
                <li class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">{skill}</li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Certifications</h3>
            <ul class="mt-4 space-y-2">
              {certifications.map(c => (
                <li class="flex items-start gap-2 text-sm text-slate-600 dark:text-slate-300">
                  <span class="mt-0.5 text-cyan-500">✓</span>{c}
                </li>
              ))}
            </ul>
            <a href="https://learn.microsoft.com/en-us/users/ahmedbayoumy-2721/transcript/d9w5za2g1lrxow1" target="_blank"
               class="mt-4 inline-block text-sm font-medium text-cyan-600 underline-offset-4 hover:underline dark:text-cyan-400">
              View Microsoft Certification Transcript →
            </a>
          </div>
        </div>

        <!-- Experience -->
        <div>
          <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Experience</h3>
          <ul class="mt-4 space-y-6">
            {experience.map(job => (
              <li>
                <div class="text-sm font-semibold">{job.role}</div>
                <div class="text-sm text-slate-500 dark:text-slate-400">{job.company}</div>
                <div class="text-xs text-slate-400">{job.period}</div>
                <ul class="mt-2 space-y-1 pl-4">
                  {job.points.map(p => (
                    <li class="text-sm text-slate-600 dark:text-slate-300 before:mr-2 before:content-['–']">{p}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-950 py-10 text-center text-sm text-slate-400">
    <div class="mx-auto max-w-4xl px-6">
      <p>© {new Date().getFullYear()} <a href={`mailto:${profile.email}`} class="text-cyan-400 hover:underline">{profile.email}</a></p>
      <p class="mt-2 text-xs">Built with Astro — content from <a href={profile.site} class="hover:underline">abayoumy.tech</a></p>
    </div>
  </footer>

</body>
</html>
